---
import Base from "../layouts/Base.astro";
---

<Base title="Not a page" description="This page does not exist.">
  <section class="measure mx-auto px-5 py-24 sm:px-8">
    <p class="eyebrow eyebrow-rust m-0">404</p>
    <h1 class="font-display mt-5 mb-0 text-h1">
      Nothing here
    </h1>
    <p class="mt-6 mb-0 text-lg leading-relaxed text-ink-warm">
      Either I moved it or you typed it. Both are forgivable.
    </p>
    <p class="mt-8 mb-0 flex flex-wrap gap-x-6 gap-y-3">
      <a href="/" class="link">Back to the start</a>
      <a href="/music" class="link">Listen to something</a>
      <a href="/musings" class="link">Read something</a>
    </p>
  </section>
</Base>
