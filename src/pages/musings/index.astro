---
import Base from "../../layouts/Base.astro";
import MusingRow from "../../components/MusingRow.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getMusings } from "../../lib/content";

const musings = await getMusings();
---

<Base
  title="Musings"
  description="Essays about guitar, maths, and making things slowly."
  image="/og/musings.png"
>
  <PageHeader
    eyebrow="Musings"
    title="Things I wrote down to find out what I thought"
    intro="No schedule, no newsletter, no growth strategy. They appear when something has been rattling around long enough to be worth the trouble."
  />

  <section class="measure-wide mx-auto px-5 pb-20 sm:px-8">
    {
      musings.length > 0 && (
        <ol class="m-0 list-none p-0">
          {musings.map((musing, index) => (
            <MusingRow musing={musing} index={index} />
          ))}
        </ol>
      )
    }
  </section>
</Base>
