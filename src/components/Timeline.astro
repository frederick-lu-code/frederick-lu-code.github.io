---
import type { Role } from "../data/experience";

interface Props {
  roles: Role[];
}

const { roles } = Astro.props;

function initials(firm: string) {
  return firm
    .split(/\s+/)
    .filter((word) => /^[A-Z]/.test(word))
    .slice(0, 2)
    .map((word) => word[0])
    .join("");
}
---

<div class="timeline relative" data-timeline>
  {/* The rail and its progress fill sit behind the entries. */}
  <div class="timeline-rail" aria-hidden="true">
    <div class="timeline-fill" data-timeline-fill></div>
  </div>

  <ol class="m-0 list-none p-0">
    {
      roles.map((role) => (
        <li class="timeline-entry" data-entry>
          <span class="timeline-dot" aria-hidden="true" />

          <p class="eyebrow m-0">
            <time datetime={role.start}>{role.period}</time>
          </p>

          <div class="mt-3 flex items-center gap-3">
            {role.logo ? (
              <img
                src={role.logo}
                alt=""
                class="timeline-logo"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="timeline-monogram" aria-hidden="true">
                {role.monogram ?? initials(role.firm)}
              </span>
            )}
            <h2 class="text-title">{role.firm}</h2>
          </div>

          <p class="mt-2 mb-0 text-ink-warm">{role.title}</p>
          {role.location && (
            <p class="mt-1 mb-0 text-meta text-stone">{role.location}</p>
          )}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .timeline-rail {
    position: absolute;
    inset-block: 0.35rem 1rem;
    left: 0;
    width: 1px;
    background-color: var(--color-hairline);
  }

  /* Height is written by the script as the page scrolls. */
  .timeline-fill {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: var(--timeline-progress, 0%);
    background-color: var(--color-rust);
  }

  .timeline-entry {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 3.5rem;
  }
  .timeline-entry:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 0.5rem;
    height: 0.5rem;
    translate: -50% 0;
    border-radius: 50%;
    background-color: var(--color-paper);
    box-shadow: 0 0 0 1px var(--color-stone);
    transition:
      background-color 0.4s ease,
      box-shadow 0.4s ease;
  }
  [data-entry].is-visible .timeline-dot {
    background-color: var(--color-rust);
    box-shadow: 0 0 0 1px var(--color-rust);
  }

  .timeline-logo {
    height: 1.5rem;
    width: auto;
    /* The files are already ink; this only softens them onto the paper. */
    opacity: 0.9;
  }

  .timeline-monogram {
    display: grid;
    place-items: center;
    height: 1.5rem;
    min-width: 1.5rem;
    padding-inline: 0.35rem;
    border: 1px solid var(--color-hairline);
    background-color: var(--color-paper-light);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--color-stone-warm);
  }

  /* Entries only start hidden once the script is running, so the page is
     complete for anyone without JavaScript. */
  [data-timeline-ready] [data-entry] {
    opacity: 0;
    translate: 0 0.75rem;
    transition:
      opacity 0.5s ease,
      translate 0.5s ease;
  }
  [data-timeline-ready] [data-entry].is-visible {
    opacity: 1;
    translate: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-timeline-ready] [data-entry] {
      opacity: 1;
      translate: none;
      transition: none;
    }
  }
</style>

<script>
  const timeline = document.querySelector<HTMLElement>("[data-timeline]");
  const fill = document.querySelector<HTMLElement>("[data-timeline-fill]");

  if (timeline && fill) {
    const entries = Array.from(
      timeline.querySelectorAll<HTMLElement>("[data-entry]"),
    );

    timeline.setAttribute("data-timeline-ready", "");

    const observer = new IntersectionObserver(
      (records) => {
        for (const record of records) {
          if (!record.isIntersecting) continue;
          record.target.classList.add("is-visible");
          /* Reveals are one-way; re-hiding on scroll-up is distracting. */
          observer.unobserve(record.target);
        }
      },
      { rootMargin: "0px 0px -15% 0px", threshold: 0.15 },
    );

    for (const entry of entries) observer.observe(entry);

    /* The rust fill tracks how far the middle of the viewport has travelled
       through the timeline. */
    let queued = false;

    function drawProgress() {
      queued = false;
      const box = timeline!.getBoundingClientRect();
      const middle = window.innerHeight / 2;
      const progress = (middle - box.top) / box.height;
      const clamped = Math.min(Math.max(progress, 0), 1);
      fill!.style.setProperty("--timeline-progress", `${clamped * 100}%`);
    }

    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(drawProgress);
    }

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll, { passive: true });
    drawProgress();
  }
</script>
