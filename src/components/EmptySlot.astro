---
interface Props {
  /** What goes here, e.g. "No covers yet". */
  label: string;
  /** Where to put the file that fills it. Shown quietly underneath. */
  hint?: string;
  /** Matches the aspect of the thing it stands in for. */
  tall?: boolean;
}

const { label, hint, tall = false } = Astro.props;
---

<div
  class:list={[
    "flex flex-col items-center justify-center gap-2 border border-dashed border-hairline px-6 text-center",
    tall ? "py-20" : "py-14",
  ]}
>
  <p class="eyebrow m-0">{label}</p>
  {hint && <p class="m-0 text-meta text-stone">{hint}</p>}
</div>
